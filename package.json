{
  "name": "kora-plus",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.18.0",
    "npm": "10.9.3"
  },
  "workspaces": [
    "apps/web",
    "apps/admin",
    "apps/api",
    "packages/contracts",
    "packages/config",
    "packages/ui"
  ],
  "overrides": {
    "@nestjs/platform-express@11.1.28": {
      "multer": "2.3.0"
    },
    "@prisma/config@7.9.1": {
      "deepmerge-ts": "8.0.1"
    },
    "prisma@7.9.1": {
      "mysql2": "3.23.1"
    },
    "ajv@8.18.0": {
      "fast-uri": "3.1.6"
    },
    "body-parser@2.3.0": {
      "qs": "6.16.0"
    },
    "brace-expansion": "5.0.9",
    "express@5.2.1": {
      "qs": "6.16.0"
    },
    "js-yaml@3.15.0": "3.15.2",
    "js-yaml@4.3.0": "4.3.2",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "sharp": "0.35.4",
    "superagent@10.3.0": {
      "qs": "6.16.0"
    }
  },
  "scripts": {
    "env:check": "node scripts/check-environment.mjs",
    "format": "node scripts/run-workspace-task.mjs format",
    "lint": "node scripts/run-workspace-task.mjs lint",
    "typecheck": "node scripts/run-workspace-task.mjs typecheck",
    "test": "node scripts/run-workspace-task.mjs test",
    "build": "node scripts/run-workspace-task.mjs build",
    "test:tooling": "node --test scripts/run-workspace-task.test.mjs scripts/ci/validate-workflows.test.mjs scripts/openapi/validate-openapi.test.mjs scripts/security/scan-repository.test.mjs",
    "launcher:verify": "node scripts/ci/verify-launcher-failure.mjs",
    "ci:validate": "node scripts/ci/validate-workflows.mjs",
    "security:scan": "node scripts/security/scan-repository.mjs",
    "openapi:validate": "node scripts/openapi/validate-openapi.mjs",
    "db:generate": "npm run db:generate --workspace @kora-plus/api",
    "licenses": "node scripts/report-licenses.mjs",
    "infra:prepare": "node scripts/infra/cli.mjs prepare",
    "infra:validate": "node scripts/infra/cli.mjs validate",
    "infra:pull": "node scripts/infra/cli.mjs pull",
    "infra:up": "node scripts/infra/cli.mjs up",
    "infra:status": "node scripts/infra/cli.mjs status",
    "infra:check": "node scripts/infra/cli.mjs check",
    "infra:down": "node scripts/infra/cli.mjs down",
    "infra:reset": "node scripts/infra/cli.mjs reset",
    "infra:verify": "node scripts/infra/verify-lifecycle.mjs",
    "infra:verify-api": "node scripts/infra/verify-api-health.mjs"
  }
}
