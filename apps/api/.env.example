NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=kora_local
# API runtime only: never use the PostgreSQL owner/migrator account here.
DATABASE_USER=kora_runtime
DATABASE_PASSWORD=read-from-local-runtime-secret
DATABASE_SSL=false

# C1 writer only: identity and secret must differ from DATABASE_USER/PASSWORD.
ADMIN_DATABASE_HOST=127.0.0.1
ADMIN_DATABASE_PORT=5432
ADMIN_DATABASE_NAME=kora_local
ADMIN_DATABASE_USER=kora_admin_writer
ADMIN_DATABASE_PASSWORD=read-from-local-admin-writer-secret
ADMIN_DATABASE_SSL=false

# C2a foundations are fail-closed and disabled unless this flag is true.
# When enabled, select exactly one process profile and provide only its matching
# user/password pair. Foreign profile credentials are rejected.
ADMIN_C2A_ENABLED=false
# ADMIN_C2A_PROFILE=HTTP
# ADMIN_C2A_DATABASE_HOST=127.0.0.1
# ADMIN_C2A_DATABASE_PORT=5432
# ADMIN_C2A_DATABASE_NAME=kora_local
# ADMIN_C2A_DATABASE_SSL=false
# HTTP only:
# ADMIN_C2A_WRITER_DATABASE_USER=kora_admin_c2a_writer
# ADMIN_C2A_WRITER_DATABASE_PASSWORD=read-from-local-c2a-writer-secret
# NOTIFICATION only:
# ADMIN_C2A_NOTIFICATION_WORKER_DATABASE_USER=kora_admin_c2a_notification_worker
# ADMIN_C2A_NOTIFICATION_WORKER_DATABASE_PASSWORD=read-from-local-c2a-notification-secret
# EXPIRATION only:
# ADMIN_C2A_EXPIRATION_WORKER_DATABASE_USER=kora_admin_c2a_expiration_worker
# ADMIN_C2A_EXPIRATION_WORKER_DATABASE_PASSWORD=read-from-local-c2a-expiration-secret
# BOOTSTRAP only:
# ADMIN_C2A_BOOTSTRAP_DATABASE_USER=kora_admin_c2a_bootstrap
# ADMIN_C2A_BOOTSTRAP_DATABASE_PASSWORD=read-from-local-c2a-bootstrap-secret

# Exact HTTPS origin accepted by the C1 request policy.
ADMIN_ORIGIN=https://admin.kora.invalid

# Dedicated C1 Redis client. No offline queue or unbounded retry is permitted.
ADMIN_REDIS_HOST=127.0.0.1
ADMIN_REDIS_PORT=6379
ADMIN_REDIS_PASSWORD=
ADMIN_REDIS_TLS=false
ADMIN_REDIS_WAIT_AOF_TIMEOUT_MS=1000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

READINESS_TIMEOUT_MS=1000

# Optional. No SDK initialization or network traffic occurs while the DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
