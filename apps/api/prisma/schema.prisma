generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// S1.2-02 canonical schema, materialized by the versioned PostgreSQL baseline.
// PostgreSQL-only invariants are defined in the accompanying migration SQL.

enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum OtpPurpose {
  REGISTER
  LOGIN
  STEP_UP
}

enum ArtistStatus {
  ACTIVE
  SUSPENDED
}

enum MediaAssetKind {
  AUDIO_MASTER
  COVER_IMAGE
}

enum MediaProcessingStatus {
  PREPARING
  UPLOAD_PENDING
  PROCESSING
  READY
  FAILED
}

enum MediaProvider {
  MUX
}

enum OrderState {
  CREATED
  PAYMENT_PENDING
  SETTLED
  CANCELLED
}

enum Currency {
  XOF
}

enum PaymentProvider {
  SANDBOX_NEUTRAL
}

enum PaymentAttemptState {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum InboxProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  REJECTED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerAccountKind {
  PROVIDER_CLEARING
  CUSTOMER_RECEIVABLE
  ARTIST_PAYABLE
  PLATFORM_REVENUE
  TAX_PAYABLE
  REFUND_LIABILITY
}

enum EntitlementSource {
  PURCHASE
}

enum ArtistEarningAllocationPolicy {
  FLOOR_SETTLEMENT_WITH_ARTIST_CARRY_V1
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_EDITOR
  FINANCE_MANAGER
  SUPPORT
}

enum AdminStatus {
  INVITED
  PENDING_MFA
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AdminPreAuthPurpose {
  FIRST_TOTP_ENROLLMENT
  TOTP_VERIFY
}

enum AdminStepUpPurpose {
  SESSION_REVOCATION
  RECOVERY_APPROVAL
  AUDIT_EXPORT
  INVITATION
  ROLE_CHANGE
  STATUS_CHANGE
}

enum AdminAuditContext {
  ADMIN_SESSION
  ADMIN_RECOVERY
  SYSTEM
}

enum AdminAuditEventClass {
  LOGIN
  SESSION
  EXPORT
  BUSINESS
}

enum AdminSecurityEventOutcome {
  SUCCEEDED
  FAILED
}

enum AdminReasonCode {
  SECURITY_RESPONSE
  ACCOUNT_RECOVERY
  ROLE_ADMINISTRATION
  STATUS_ADMINISTRATION
  AUDIT_EXPORT
  INVITATION_ADMINISTRATION
}

enum AdminAuditOutcome {
  SUCCESS
  REJECTED
}

enum AdminAuditFailureCode {
  FORBIDDEN
  STEP_UP_REQUIRED
  STEP_UP_EXPIRED
  STEP_UP_INVALID
  INTEGRITY_REJECTED
  DEPENDENCY_UNAVAILABLE
  VALIDATION_ERROR
  IDEMPOTENCY_CONFLICT
  RESOURCE_NOT_FOUND
  RESOURCE_CONFLICT
  RESOURCE_EXPIRED
  PROJECTION_BUDGET_EXCEEDED
}

enum AdminRecoveryCaseState {
  PENDING
  APPROVED
  CANCELLED
  EXPIRED
}

enum AdminInvitationState {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AdminNotificationPurpose {
  PASSWORD_RESET
  INVITATION
}

enum AdminNotificationState {
  PENDING
  CLAIMED
  DELIVERED
  FAILED
  DELIVERY_UNCERTAIN
  CANCELLED
}

enum AdminSnapshotOperation {
  LIST_ADMIN_RECOVERY_CASES
  LIST_ADMIN_USERS
  LIST_ADMIN_AUDIT_LOGS
}

enum AdminC2IdempotencyOperation {
  CREATE_ADMIN_RECOVERY_CASE
  APPROVE_ADMIN_RECOVERY_CASE
  CREATE_ADMIN_AUDIT_LOG_EXPORT
  CREATE_ADMIN_INVITATION
  CHANGE_ADMIN_USER_ROLE
  CHANGE_ADMIN_USER_STATUS
}

model Customer {
  id                 String              @id @default(uuid())
  verifiedPhone      String              @unique
  optionalEmail      String?             @unique
  passwordHash       String
  status             CustomerStatus      @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  devices            CustomerDevice[]
  sessions           CustomerSession[]
  otpChallenges      OtpChallenge[]
  orders             Order[]
  entitlements       Entitlement[]
  idempotencyRecords IdempotencyRecord[]

  @@index([status, createdAt])
}

model CustomerDevice {
  id                   String                        @id @default(uuid())
  customerId           String
  customer             Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fingerprintHash      String
  platform             DevicePlatform
  registeredAt         DateTime                      @default(now())
  lastSeenAt           DateTime                      @default(now())
  revokedAt            DateTime?
  sessions             CustomerSession[]
  purchasedDescriptors PurchasedPlaybackDescriptor[]

  @@unique([customerId, fingerprintHash])
  @@unique([id, customerId])
  @@index([customerId, revokedAt])
}

model CustomerSession {
  id                  String         @id @default(uuid())
  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deviceId            String
  device              CustomerDevice @relation(fields: [deviceId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  sessionFamilyId     String
  accessTokenId       String         @unique
  refreshTokenHash    String         @unique
  refreshTokenVersion Int            @default(1)
  lastOtpStepUpAt     DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime       @default(now())
  otpChallenges       OtpChallenge[]

  @@unique([id, customerId])
  @@index([customerId, revokedAt])
  @@index([sessionFamilyId, revokedAt])
}

model OtpChallenge {
  id                    String           @id @default(uuid())
  normalizedPhone       String
  purpose               OtpPurpose
  codeHash              String
  customerId            String?
  customer              Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessionId             String?
  session               CustomerSession? @relation(fields: [sessionId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  pendingPasswordHash   String?
  passwordVerifiedAt    DateTime?
  deviceFingerprintHash String
  devicePlatform        DevicePlatform
  attempts              Int              @default(0)
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime         @default(now())

  @@index([normalizedPhone, purpose, createdAt])
  @@index([customerId, purpose, consumedAt])
  @@index([sessionId, customerId])
}

model AdminUser {
  id                      String                      @id @default(uuid())
  email                   String                      @unique
  passwordHash            String
  role                    AdminRole
  status                  AdminStatus                 @default(DISABLED)
  authorizationVersion    Int                         @default(1)
  totpSecretEncrypted     String?
  totpEnabledAt           DateTime?
  lastAcceptedTotpCounter BigInt?
  createdAt               DateTime                    @default(now())
  c2aInvitationCreatedXid BigInt?
  sessions                AdminSession[]
  recoveryCodes           AdminRecoveryCode[]
  preAuthContexts         AdminPreAuthContext[]
  totpEnrollments         AdminTotpEnrollment[]
  recoveryContexts        AdminRecoveryContext[]
  refreshTokens           AdminRefreshToken[]
  recoveryCodeBatches     AdminRecoveryCodeBatch[]
  securityEvents          AdminSecurityEvent[]
  createdArtists          Artist[]                    @relation("ArtistCreatedByAdmin")
  createdAudioContents    AudioContent[]              @relation("AudioContentCreatedByAdmin")
  publications            ContentPublication[]
  actorAuditLogs          AuditLog[]                  @relation("AuditActor")
  subjectAuditLogs        AuditLog[]                  @relation("AuditSubject")
  delegatedAuditLogs      AuditLog[]                  @relation("AuditDelegatedBy")
  idempotencyRecords      AdminIdempotencyRecord[]
  passwordResetRequests   AdminPasswordResetRequest[]
  passwordResetContexts   AdminPasswordResetContext[]
  recoveryCasesAsSubject  AdminRecoveryCase[]         @relation("RecoveryCaseSubject")
  recoveryCasesAsCreator  AdminRecoveryCase[]         @relation("RecoveryCaseCreator")
  recoveryCasesAsApprover AdminRecoveryCase[]         @relation("RecoveryCaseApprover")
  createdInvitations      AdminInvitation[]           @relation("InvitationCreator")
  acceptedInvitations     AdminInvitation[]           @relation("InvitationAcceptedAdmin")
  c2Snapshots             AdminPaginationSnapshot[]
  c2IdempotencyRecords    AdminC2IdempotencyRecord[]
  bootstrapGuard          AdminBootstrapGuard?
}

model AdminSession {
  id                   String              @id @default(uuid())
  adminUserId          String
  adminUser            AdminUser           @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenFamilyId        String
  accessTokenJti       String              @unique
  refreshTokenHash     String              @unique
  refreshTokenVersion  Int                 @default(1)
  lastTwoFactorAt      DateTime
  lastActivityAt       DateTime            @default(now())
  expiresAt            DateTime
  absoluteExpiresAt    DateTime?
  authorizationVersion Int?
  stepUpPurpose        AdminStepUpPurpose?
  stepUpVerifiedAt     DateTime?
  stepUpExpiresAt      DateTime?
  revokedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  refreshTokens        AdminRefreshToken[]
  auditLogs            AuditLog[]          @relation("AuditSession")

  @@unique([id, adminUserId])
  @@unique([adminUserId, tokenFamilyId])
  @@index([adminUserId, revokedAt])
  @@index([expiresAt])
}

model AdminRecoveryCode {
  id               String                  @id @default(uuid())
  adminUserId      String
  adminUser        AdminUser               @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batchId          String?
  batch            AdminRecoveryCodeBatch? @relation(fields: [batchId, adminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  selector         String?                 @unique
  codeHash         String
  usedAt           DateTime?
  createdAt        DateTime                @default(now())
  recoveryContexts AdminRecoveryContext[]

  @@unique([id, adminUserId])
  @@unique([adminUserId, codeHash])
  @@index([adminUserId, usedAt])
}

model AdminPreAuthContext {
  id                   String               @id @default(uuid())
  adminUserId          String
  adminUser            AdminUser            @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash            String               @unique
  purpose              AdminPreAuthPurpose
  authorizationVersion Int
  expiresAt            DateTime
  consumedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime             @default(now())
  totpEnrollment       AdminTotpEnrollment? @relation("EnrollmentPreAuth")

  @@unique([id, adminUserId])
  @@index([adminUserId, expiresAt])
}

model AdminTotpEnrollment {
  id                     String                @id @default(uuid())
  adminUserId            String
  adminUser              AdminUser             @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminPreAuthContextId  String?               @unique
  adminPreAuthContext    AdminPreAuthContext?  @relation("EnrollmentPreAuth", fields: [adminPreAuthContextId, adminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  adminRecoveryContextId String?               @unique
  adminRecoveryContext   AdminRecoveryContext? @relation("EnrollmentRecovery", fields: [adminRecoveryContextId, adminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  secretEncrypted        String
  authorizationVersion   Int
  expiresAt              DateTime
  qrDeliveredAt          DateTime?
  confirmedAt            DateTime?
  revokedAt              DateTime?
  createdAt              DateTime              @default(now())

  @@unique([id, adminUserId])
  @@unique([adminPreAuthContextId, adminUserId])
  @@unique([adminRecoveryContextId, adminUserId])
  @@index([adminUserId, expiresAt])
}

model AdminRecoveryContext {
  id                   String               @id @default(uuid())
  adminUserId          String
  adminUser            AdminUser            @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash            String               @unique
  recoveryCodeId       String               @unique
  recoveryCode         AdminRecoveryCode    @relation(fields: [recoveryCodeId, adminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  authorizationVersion Int
  expiresAt            DateTime
  consumedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime             @default(now())
  totpEnrollment       AdminTotpEnrollment? @relation("EnrollmentRecovery")
  auditLogs            AuditLog[]           @relation("AuditRecovery")

  @@unique([id, adminUserId])
  @@index([adminUserId, expiresAt])
}

model AdminRefreshToken {
  id              String             @id @default(uuid())
  adminUserId     String
  adminUser       AdminUser          @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminSessionId  String
  adminSession    AdminSession       @relation(fields: [adminSessionId, adminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  previousTokenId String?            @unique
  previousToken   AdminRefreshToken? @relation("AdminRefreshChain", fields: [previousTokenId, adminUserId, adminSessionId], references: [id, adminUserId, adminSessionId], onDelete: Restrict, onUpdate: Restrict)
  nextToken       AdminRefreshToken? @relation("AdminRefreshChain")
  tokenHash       String             @unique
  generation      Int
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime           @default(now())

  @@unique([id, adminUserId, adminSessionId])
  @@unique([previousTokenId, adminUserId, adminSessionId])
  @@index([adminSessionId, generation])
  @@index([adminUserId, expiresAt])
}

model AdminRecoveryCodeBatch {
  id          String              @id @default(uuid())
  adminUserId String
  adminUser   AdminUser           @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedAt   DateTime?
  createdAt   DateTime            @default(now())
  codes       AdminRecoveryCode[]

  @@unique([id, adminUserId])
  @@index([adminUserId, createdAt])
}

model AdminSecurityEvent {
  id                   String                     @id @default(uuid())
  adminUserId          String?
  adminUser            AdminUser?                 @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventClass           AdminAuditEventClass
  action               String
  outcome              AdminSecurityEventOutcome
  failureCode          String?
  requestId            String
  subjectRefHash       String?
  entityType           String?
  entityId             String?
  adminInvitationId    String?
  adminInvitation      AdminInvitation?           @relation("InvitationSecurityEvents", fields: [adminInvitationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  passwordResetRequest AdminPasswordResetRequest? @relation("PasswordResetSourceEvent")
  notificationOutboxes AdminNotificationOutbox[]  @relation("OutboxSecurityEventSource")
  auditCausations      AuditLog[]                 @relation("AuditSecurityCausation")
  createdAt            DateTime                   @default(now())

  @@unique([id, entityId])
  @@index([adminUserId, createdAt])
  @@index([eventClass, action, createdAt])
  @@index([entityType, entityId, createdAt])
}

// PASSWORD_RESET is physically separate from the C1 MFA recovery context.
model AdminPasswordResetRequest {
  id                 String                     @id @default(uuid())
  adminUserId        String
  adminUser          AdminUser                  @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  securityEventId    String                     @unique
  securityEvent      AdminSecurityEvent         @relation("PasswordResetSourceEvent", fields: [securityEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacedRequestId  String?                    @unique
  replacedRequest    AdminPasswordResetRequest? @relation("PasswordResetReplacement", fields: [replacedRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacementRequest AdminPasswordResetRequest? @relation("PasswordResetReplacement")
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime                   @default(now())
  context            AdminPasswordResetContext?
  notificationOutbox AdminNotificationOutbox?

  @@unique([id, adminUserId])
  @@unique([securityEventId, id])
  @@index([adminUserId, createdAt])
  @@index([expiresAt])
}

model AdminPasswordResetContext {
  id                     String                    @id @default(uuid())
  passwordResetRequestId String                    @unique
  passwordResetRequest   AdminPasswordResetRequest @relation(fields: [passwordResetRequestId, adminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  adminUserId            String
  adminUser              AdminUser                 @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash              String                    @unique
  authorizationVersion   Int
  expiresAt              DateTime
  consumedAt             DateTime?
  revokedAt              DateTime?
  createdAt              DateTime                  @default(now())
  auditLogs              AuditLog[]                @relation("AuditPasswordReset")

  @@unique([id, adminUserId])
  @@unique([passwordResetRequestId, adminUserId])
  @@index([adminUserId, expiresAt])
}

model AdminRecoveryCase {
  id                  String                 @id @default(uuid())
  subjectAdminUserId  String
  subjectAdminUser    AdminUser              @relation("RecoveryCaseSubject", fields: [subjectAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creatorAdminUserId  String
  creatorAdminUser    AdminUser              @relation("RecoveryCaseCreator", fields: [creatorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approverAdminUserId String?
  approverAdminUser   AdminUser?             @relation("RecoveryCaseApprover", fields: [approverAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  state               AdminRecoveryCaseState @default(PENDING)
  stateGeneration     Int                    @default(1)
  expiresAt           DateTime
  approvedAt          DateTime?
  cancelledAt         DateTime?
  expiredAt           DateTime?
  createdAt           DateTime               @default(now())
  auditLogs           AuditLog[]             @relation("AuditRecoveryCase")

  @@index([subjectAdminUserId, createdAt])
  @@index([state, expiresAt])
}

model AdminInvitation {
  id                     String                   @id @default(uuid())
  emailCanonical         String
  deliveryEmailEncrypted String
  codeHash               String                   @unique
  proposedRole           AdminRole
  creatorAdminUserId     String
  creatorAdminUser       AdminUser                @relation("InvitationCreator", fields: [creatorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByAuditLogId    String                   @unique
  createdByAuditLog      AuditLog                 @relation("InvitationCreatedByAudit", fields: [createdByAuditLogId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedAdminUserId    String?                  @unique
  acceptedAdminUser      AdminUser?               @relation("InvitationAcceptedAdmin", fields: [acceptedAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacedInvitationId   String?                  @unique
  replacedInvitation     AdminInvitation?         @relation("InvitationReplacement", fields: [replacedInvitationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacementInvitation  AdminInvitation?         @relation("InvitationReplacement")
  state                  AdminInvitationState     @default(PENDING)
  stateGeneration        Int                      @default(1)
  expiresAt              DateTime
  acceptedAt             DateTime?
  revokedAt              DateTime?
  expiredAt              DateTime?
  createdAt              DateTime                 @default(now())
  notificationOutbox     AdminNotificationOutbox?
  securityEvents         AdminSecurityEvent[]     @relation("InvitationSecurityEvents")
  auditLogs              AuditLog[]               @relation("AuditInvitation")

  @@unique([createdByAuditLogId, id])
  @@index([emailCanonical, createdAt])
  @@index([state, expiresAt])
}

model AdminNotificationOutbox {
  id                          String                     @id @default(uuid())
  purpose                     AdminNotificationPurpose
  state                       AdminNotificationState     @default(PENDING)
  generation                  Int                        @default(1)
  encryptedPayload            String
  encryptionKeyId             String
  encryptionNonce             String
  encryptionTag               String
  aadHash                     String
  sourceSecurityEventId       String?
  sourceSecurityEvent         AdminSecurityEvent?        @relation("OutboxSecurityEventSource", fields: [sourceSecurityEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceAuditLogId            String?
  sourceAuditLog              AuditLog?                  @relation("OutboxAuditSource", fields: [sourceAuditLogId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  passwordResetRequestId      String?                    @unique
  passwordResetRequest        AdminPasswordResetRequest? @relation(fields: [passwordResetRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminInvitationId           String?                    @unique
  adminInvitation             AdminInvitation?           @relation(fields: [adminInvitationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacedOutboxId            String?                    @unique
  replacedOutbox              AdminNotificationOutbox?   @relation("OutboxReplacement", fields: [replacedOutboxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacementOutbox           AdminNotificationOutbox?   @relation("OutboxReplacement")
  claimOwnerHash              String?
  leaseExpiresAt              DateTime?
  attemptCount                Int                        @default(0)
  nextAttemptAt               DateTime?
  providerAcknowledgementHash String?
  deliveredAt                 DateTime?
  failedAt                    DateTime?
  uncertainAt                 DateTime?
  cancelledAt                 DateTime?
  createdAt                   DateTime                   @default(now())
  auditLogs                   AuditLog[]                 @relation("AuditNotificationOutbox")

  @@index([state, nextAttemptAt, createdAt])
}

model AdminPaginationSnapshot {
  id                   String                        @id @default(uuid())
  principalAdminUserId String
  principalAdminUser   AdminUser                     @relation(fields: [principalAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation            AdminSnapshotOperation
  filtersDigest        String
  projectionVersion    Int
  entryCount           Int
  utf8Bytes            BigInt
  createdAt            DateTime                      @default(now())
  expiresAt            DateTime
  items                AdminPaginationSnapshotItem[]

  @@index([principalAdminUserId, operation, createdAt])
  @@index([expiresAt])
}

model AdminPaginationSnapshotItem {
  snapshotId      String
  snapshot        AdminPaginationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  ordinal         Int
  resourceId      String
  sourceCreatedAt DateTime
  projectionJson  String
  utf8Bytes       Int

  @@id([snapshotId, ordinal])
  @@unique([snapshotId, resourceId])
}

model AdminBootstrapGuard {
  singletonKey        String     @id
  adminUserId         String     @unique
  adminUser           AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bootstrapAuditLogId String     @unique
  bootstrapAuditLog   AuditLog   @relation("BootstrapGuardAudit", fields: [bootstrapAuditLogId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt           DateTime   @default(now())
  auditLogs           AuditLog[] @relation("AuditBootstrapGuard")
}

model Artist {
  id                    String             @id @default(uuid())
  createdByAdminId      String
  createdByAdmin        AdminUser          @relation("ArtistCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stageName             String
  status                ArtistStatus       @default(ACTIVE)
  artistRevenueShareBps Int                @default(2000)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  audioContents         AudioContent[]
  earnings              ArtistEarning[]
  artistSettlements     ArtistSettlement[]

  @@index([status, stageName])
}

model AudioContent {
  id               String               @id @default(uuid())
  artistId         String
  artist           Artist               @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByAdminId String
  createdByAdmin   AdminUser            @relation("AudioContentCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  title            String
  description      String?
  priceCfa         Int
  previewSeconds   Int                  @default(30)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  mediaAssets      MediaAsset[]
  publications     ContentPublication[]
  orderItems       OrderItem[]
  entitlements     Entitlement[]
  previewGrants    PreviewGrant[]
  artistEarnings   ArtistEarning[]

  @@unique([id, artistId])
  @@index([artistId, createdAt])
}

model MediaAsset {
  id                       String                  @id @default(uuid())
  audioContentId           String
  audioContent             AudioContent            @relation(fields: [audioContentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind                     MediaAssetKind
  processingStatus         MediaProcessingStatus   @default(PREPARING)
  version                  Int                     @default(1)
  checksumSha256           String?
  durationSeconds          Int?
  privateStorageObjectKey  String?
  privateProviderUploadRef String?
  privateProviderAssetRef  String?
  provider                 MediaProvider?
  failureCode              String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  publicationLinks         PublicationMediaAsset[]
  webhookInboxEvents       MediaWebhookInbox[]

  @@unique([audioContentId, kind, version])
  @@unique([id, audioContentId, kind, version])
  @@unique([provider, privateProviderUploadRef])
  @@unique([provider, privateProviderAssetRef])
  @@index([audioContentId, processingStatus])
}

model MediaWebhookInbox {
  id                  String                @id @default(uuid())
  provider            MediaProvider         @default(MUX)
  providerEventKey    String
  mediaAssetId        String?
  mediaAsset          MediaAsset?           @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventType           String
  payloadHash         String
  encryptedPayload    String
  signatureVerifiedAt DateTime
  processingStatus    InboxProcessingStatus @default(RECEIVED)
  receivedAt          DateTime              @default(now())
  processedAt         DateTime?

  @@unique([provider, providerEventKey])
  @@index([processingStatus, receivedAt])
  @@index([mediaAssetId, receivedAt])
}

// An active row is the public visibility fact. Creating it requires one READY
// PublicationMediaAsset for every required kind in the same transaction.
// Mux/provider callbacks never create this record. The service must also keep
// at most one row with archivedAt = null per audioContentId.
model ContentPublication {
  id                 String                  @id @default(uuid())
  audioContentId     String
  audioContent       AudioContent            @relation(fields: [audioContentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedByAdminId String
  publishedByAdmin   AdminUser               @relation(fields: [publishedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedAt        DateTime                @default(now())
  archivedAt         DateTime?
  mediaAssets        PublicationMediaAsset[]

  @@unique([id, audioContentId])
  @@index([audioContentId, archivedAt])
}

model PublicationMediaAsset {
  id                String             @id @default(uuid())
  publicationId     String
  audioContentId    String
  publication       ContentPublication @relation(fields: [publicationId, audioContentId], references: [id, audioContentId], onDelete: Restrict, onUpdate: Restrict)
  kind              MediaAssetKind
  mediaAssetId      String
  mediaAssetVersion Int
  mediaAsset        MediaAsset         @relation(fields: [mediaAssetId, audioContentId, kind, mediaAssetVersion], references: [id, audioContentId, kind, version], onDelete: Restrict, onUpdate: Restrict)
  readinessChecksum String
  verifiedReadyAt   DateTime

  @@unique([publicationId, kind])
  @@index([mediaAssetId, mediaAssetVersion])
}

model Order {
  id                 String              @id @default(uuid())
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id])
  currency           Currency            @default(XOF)
  totalCfa           Int
  createdAt          DateTime            @default(now())
  items              OrderItem[]
  stateEvents        OrderStateEvent[]
  paymentAttempts    PaymentAttempt[]
  settlement         Settlement?
  idempotencyRecords IdempotencyRecord[]
  entitlements       Entitlement[]

  @@unique([id, customerId])
  @@index([customerId, createdAt])
}

model OrderItem {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  audioContentId String
  audioContent   AudioContent   @relation(fields: [audioContentId], references: [id])
  titleSnapshot  String
  unitPriceCfa   Int
  quantity       Int            @default(1)
  createdAt      DateTime       @default(now())
  artistEarning  ArtistEarning?
  entitlement    Entitlement?

  @@unique([orderId, audioContentId])
  @@unique([id, orderId, audioContentId])
}

// Order state is append-only. The current state is the highest sequence.
model OrderStateEvent {
  id         String     @id @default(uuid())
  orderId    String
  order      Order      @relation(fields: [orderId], references: [id])
  sequence   Int
  state      OrderState
  reasonCode String?
  recordedAt DateTime   @default(now())

  @@unique([orderId, sequence])
  @@index([orderId, recordedAt])
}

// The attempt itself is immutable. A retry always inserts another attempt;
// state changes are append-only PaymentAttemptEvent rows.
model PaymentAttempt {
  id                 String                @id @default(uuid())
  orderId            String
  order              Order                 @relation(fields: [orderId], references: [id])
  provider           PaymentProvider
  amountCfa          Int
  currency           Currency              @default(XOF)
  idempotencyKey     String
  providerReference  String?               @unique
  createdAt          DateTime              @default(now())
  events             PaymentAttemptEvent[]
  settlement         Settlement?
  webhookInboxEvents PaymentWebhookInbox[]

  @@unique([orderId, idempotencyKey])
  @@unique([id, orderId])
  @@index([orderId, createdAt])
}

model PaymentAttemptEvent {
  id               String              @id @default(uuid())
  paymentAttemptId String
  paymentAttempt   PaymentAttempt      @relation(fields: [paymentAttemptId], references: [id])
  sequence         Int
  state            PaymentAttemptState
  safeReasonCode   String?
  recordedAt       DateTime            @default(now())
  settlement       Settlement?

  @@unique([paymentAttemptId, sequence])
  @@unique([id, paymentAttemptId])
  @@index([paymentAttemptId, recordedAt])
}

model PaymentWebhookInbox {
  id                  String                @id @default(uuid())
  provider            PaymentProvider
  providerEventKey    String
  paymentAttemptId    String?
  paymentAttempt      PaymentAttempt?       @relation(fields: [paymentAttemptId], references: [id])
  payloadHash         String
  encryptedPayload    String
  signatureVerifiedAt DateTime
  processingStatus    InboxProcessingStatus @default(RECEIVED)
  receivedAt          DateTime              @default(now())
  processedAt         DateTime?

  @@unique([provider, providerEventKey])
  @@index([processingStatus, receivedAt])
}

model OutboxEvent {
  id               String    @id @default(uuid())
  aggregateType    String
  aggregateId      String
  eventType        String
  deduplicationKey String    @unique
  payload          Json
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  @@index([publishedAt, createdAt])
}

// A settlement is the only fact allowed to create Entitlement, ledger and
// ArtistEarning rows in the same transaction.
model Settlement {
  id                      String                        @id @default(uuid())
  orderId                 String                        @unique
  order                   Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentAttemptId        String                        @unique
  paymentAttempt          PaymentAttempt                @relation(fields: [paymentAttemptId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  succeededAttemptEventId String                        @unique
  succeededAttemptEvent   PaymentAttemptEvent           @relation(fields: [succeededAttemptEventId, paymentAttemptId], references: [id, paymentAttemptId], onDelete: Restrict, onUpdate: Restrict)
  settledAmountCfa        Int
  distributableBasisCfa   Int
  artistPayableAmountCfa  Int
  platformAmountCfa       Int
  artistAllocationPolicy  ArtistEarningAllocationPolicy @default(FLOOR_SETTLEMENT_WITH_ARTIST_CARRY_V1)
  reconciliationKey       String                        @unique
  reconciledAt            DateTime
  settledAt               DateTime                      @default(now())
  entitlements            Entitlement[]
  artistSettlements       ArtistSettlement[]
  artistEarnings          ArtistEarning[]
  ledgerGroups            LedgerTransactionGroup[]

  @@unique([id, orderId])
  @@unique([paymentAttemptId, orderId])
  @@unique([succeededAttemptEventId, paymentAttemptId])
}

// One immutable row records one artist's result inside a Settlement. The
// previousArtistSettlementId uniqueness serializes carry consumption; the
// composite self-relation prevents carry transfer between artists. A future
// transaction must lock the predecessor before inserting the successor.
model ArtistSettlement {
  id                         String                        @id @default(uuid())
  settlementId               String
  orderId                    String
  settlement                 Settlement                    @relation(fields: [settlementId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  artistId                   String
  artist                     Artist                        @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settlementSequence         BigInt
  previousArtistSettlementId String?                       @unique
  previousArtistSettlement   ArtistSettlement?             @relation("ArtistSettlementCarry", fields: [previousArtistSettlementId, artistId], references: [id, artistId], onDelete: Restrict, onUpdate: Restrict)
  nextArtistSettlement       ArtistSettlement?             @relation("ArtistSettlementCarry")
  carryInNumerator           Int
  exactEarningsNumerator     BigInt
  exactNumerator             BigInt
  payableAmountCfa           Int
  carryOutNumerator          Int
  allocationPolicy           ArtistEarningAllocationPolicy @default(FLOOR_SETTLEMENT_WITH_ARTIST_CARRY_V1)
  reconciledAt               DateTime
  createdAt                  DateTime                      @default(now())
  earnings                   ArtistEarning[]

  @@unique([settlementId, artistId])
  @@unique([previousArtistSettlementId, artistId])
  @@unique([id, artistId])
  @@unique([id, settlementId, orderId, artistId])
  @@unique([artistId, settlementSequence])
  @@index([artistId, reconciledAt])
}

model LedgerAccount {
  id        String            @id @default(uuid())
  code      String            @unique
  kind      LedgerAccountKind
  ownerRef  String?
  createdAt DateTime          @default(now())
  postings  LedgerPosting[]
}

// Every group is append-only and must be posted atomically with equal total
// DEBIT and CREDIT amountCfa values. Corrections create a linked new group.
model LedgerTransactionGroup {
  id                  String                   @id @default(uuid())
  settlementId        String?
  settlement          Settlement?              @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventKey            String                   @unique
  correctionOfGroupId String?
  correctionOfGroup   LedgerTransactionGroup?  @relation("LedgerCorrection", fields: [correctionOfGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  corrections         LedgerTransactionGroup[] @relation("LedgerCorrection")
  createdAt           DateTime                 @default(now())
  postings            LedgerPosting[]

  @@index([settlementId, createdAt])
}

model LedgerPosting {
  id        String                 @id @default(uuid())
  groupId   String
  group     LedgerTransactionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountId String
  account   LedgerAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  direction LedgerDirection
  amountCfa Int
  createdAt DateTime               @default(now())

  @@index([groupId, direction])
  @@index([accountId, createdAt])
}

model ArtistEarning {
  id                    String                        @id @default(uuid())
  settlementId          String
  orderId               String
  settlement            Settlement                    @relation(fields: [settlementId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  artistSettlementId    String
  artistSettlement      ArtistSettlement              @relation(fields: [artistSettlementId, settlementId, orderId, artistId], references: [id, settlementId, orderId, artistId], onDelete: Restrict, onUpdate: Restrict)
  orderItemId           String                        @unique
  audioContentId        String
  orderItem             OrderItem                     @relation(fields: [orderItemId, orderId, audioContentId], references: [id, orderId, audioContentId], onDelete: Restrict, onUpdate: Restrict)
  artistId              String
  artist                Artist                        @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audioContent          AudioContent                  @relation(fields: [audioContentId, artistId], references: [id, artistId], onDelete: Restrict, onUpdate: Restrict)
  grossItemAmountCfa    Int
  legallyRequiredTaxCfa Int
  refundAdjustmentCfa   Int                           @default(0)
  frozenBasisCfa        Int
  artistRevenueShareBps Int
  allocationPolicy      ArtistEarningAllocationPolicy @default(FLOOR_SETTLEMENT_WITH_ARTIST_CARRY_V1)
  exactEarningNumerator BigInt
  createdAt             DateTime                      @default(now())

  @@unique([orderItemId, orderId, audioContentId])
  @@unique([artistSettlementId, settlementId, orderId, orderItemId, audioContentId, artistId])
  @@index([artistId, createdAt])
}

model Entitlement {
  id                   String                        @id @default(uuid())
  customerId           String
  customer             Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audioContentId       String
  audioContent         AudioContent                  @relation(fields: [audioContentId], references: [id])
  orderItemId          String                        @unique
  orderItem            OrderItem                     @relation(fields: [orderItemId, orderId, audioContentId], references: [id, orderId, audioContentId], onDelete: Restrict, onUpdate: Restrict)
  settlementId         String
  settlement           Settlement                    @relation(fields: [settlementId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  orderId              String
  order                Order                         @relation(fields: [orderId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  source               EntitlementSource             @default(PURCHASE)
  grantedAt            DateTime                      @default(now())
  revokedAt            DateTime?
  purchasedDescriptors PurchasedPlaybackDescriptor[]

  @@unique([customerId, audioContentId])
  @@unique([id, customerId])
  @@unique([orderItemId, orderId, audioContentId])
  @@index([audioContentId, revokedAt])
}

model PreviewGrant {
  id                    String                      @id @default(uuid())
  audioContentId        String
  audioContent          AudioContent                @relation(fields: [audioContentId], references: [id])
  anonymousDeviceHash   String
  anonymousIpBucketHash String
  tokenHash             String                      @unique
  maxDurationSeconds    Int
  expiresAt             DateTime
  createdAt             DateTime                    @default(now())
  descriptors           PreviewPlaybackDescriptor[]

  @@index([anonymousDeviceHash, audioContentId, createdAt])
  @@index([anonymousIpBucketHash, createdAt])
}

// Descriptor secrets are short-lived, stored only as hashes and never logged.
model PreviewPlaybackDescriptor {
  id             String       @id @default(uuid())
  previewGrantId String
  previewGrant   PreviewGrant @relation(fields: [previewGrantId], references: [id])
  descriptorHash String       @unique
  expiresAt      DateTime
  issuedAt       DateTime     @default(now())
}

model PurchasedPlaybackDescriptor {
  id             String         @id @default(uuid())
  customerId     String
  entitlementId  String
  entitlement    Entitlement    @relation(fields: [entitlementId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  deviceId       String
  device         CustomerDevice @relation(fields: [deviceId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  descriptorHash String         @unique
  expiresAt      DateTime
  issuedAt       DateTime       @default(now())

  @@index([customerId, entitlementId, deviceId, expiresAt])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation      String
  idempotencyKey String
  requestHash    String
  responseCode   Int
  resourceType   String
  resourceId     String
  orderId        String?
  order          Order?   @relation(fields: [orderId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([customerId, operation, idempotencyKey])
  @@index([expiresAt])
}

// Admin idempotency never stores response bodies or short-lived capabilities.
// A preparation replay resolves the same MediaAsset then reissues a fresh,
// short-lived token; the raw token is never persisted in this table.
model AdminIdempotencyRecord {
  id             String    @id @default(uuid())
  adminUserId    String
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation      String
  idempotencyKey String
  requestHash    String
  responseCode   Int
  resourceType   String
  resourceId     String
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@unique([adminUserId, operation, idempotencyKey])
  @@index([expiresAt])
}

// C2 idempotency has a fixed 24-hour window and does not alter C1 records.
model AdminC2IdempotencyRecord {
  id             String                      @id @default(uuid())
  adminUserId    String
  adminUser      AdminUser                   @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation      AdminC2IdempotencyOperation
  idempotencyKey String
  requestDigest  String
  responseCode   Int
  resourceType   String
  resourceId     String
  generation     BigInt                      @default(1)
  expiresAt      DateTime
  createdAt      DateTime                    @default(now())

  @@unique([adminUserId, operation, idempotencyKey, generation], map: "AdminC2IdempotencyRecord_key_generation_key")
  @@index([adminUserId, operation, idempotencyKey, expiresAt, generation], map: "AdminC2IdempotencyRecord_active_lookup_idx")
  @@index([expiresAt])
}

// Critical mutation and audit insert must share one transaction. Application
// roles receive no UPDATE/DELETE privilege on this table.
model AuditLog {
  id                          String                     @id @default(uuid())
  version                     Int                        @default(2)
  actorAdminUserId            String?                    @map("adminUserId")
  actorAdminUser              AdminUser?                 @relation("AuditActor", fields: [actorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectAdminUserId          String?
  subjectAdminUser            AdminUser?                 @relation("AuditSubject", fields: [subjectAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delegatedByAdminUserId      String?
  delegatedByAdminUser        AdminUser?                 @relation("AuditDelegatedBy", fields: [delegatedByAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminSessionId              String?
  adminSession                AdminSession?              @relation("AuditSession", fields: [adminSessionId, actorAdminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  adminRecoveryContextId      String?
  adminRecoveryContext        AdminRecoveryContext?      @relation("AuditRecovery", fields: [adminRecoveryContextId, actorAdminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  adminPasswordResetContextId String?
  adminPasswordResetContext   AdminPasswordResetContext? @relation("AuditPasswordReset", fields: [adminPasswordResetContextId, actorAdminUserId], references: [id, adminUserId], onDelete: Restrict, onUpdate: Restrict)
  systemExecutionRefHash      String?
  eventClass                  AdminAuditEventClass?
  context                     AdminAuditContext?
  outcome                     AdminAuditOutcome?
  failureCode                 AdminAuditFailureCode?
  action                      String
  entityType                  String
  entityId                    String
  maskedBefore                Json?
  maskedAfter                 Json?
  legacyReason                String                     @map("reason")
  reasonCode                  AdminReasonCode?
  operatorReason              String?
  requestId                   String
  causationEventId            String?
  causationEvent              AuditLog?                  @relation("AuditCausation", fields: [causationEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  causedEvents                AuditLog[]                 @relation("AuditCausation")
  causationSecurityEventId    String?
  causationSecurityEvent      AdminSecurityEvent?        @relation("AuditSecurityCausation", fields: [causationSecurityEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminRecoveryCaseId         String?
  adminRecoveryCase           AdminRecoveryCase?         @relation("AuditRecoveryCase", fields: [adminRecoveryCaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminInvitationId           String?
  adminInvitation             AdminInvitation?           @relation("AuditInvitation", fields: [adminInvitationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notificationOutboxId        String?
  notificationOutbox          AdminNotificationOutbox?   @relation("AuditNotificationOutbox", fields: [notificationOutboxId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bootstrapGuardId            String?
  bootstrapGuard              AdminBootstrapGuard?       @relation("AuditBootstrapGuard", fields: [bootstrapGuardId], references: [singletonKey], onDelete: Restrict, onUpdate: Restrict)
  createdInvitations          AdminInvitation[]          @relation("InvitationCreatedByAudit")
  notificationOutboxes        AdminNotificationOutbox[]  @relation("OutboxAuditSource")
  bootstrapGuards             AdminBootstrapGuard[]      @relation("BootstrapGuardAudit")
  createdAt                   DateTime                   @default(now())

  @@unique([id, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([actorAdminUserId, createdAt], map: "AuditLog_adminUserId_createdAt_idx")
  @@index([subjectAdminUserId, createdAt])
  @@index([context, createdAt])
}
